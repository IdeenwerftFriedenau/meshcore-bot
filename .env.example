# Set this only on the Raspberry Pi. Never commit a real key.
MESHCORE_AI_API_KEY=
# Optional dashboard LAN access: at least 24 characters. Prefer an SSH tunnel.
# MESHCORE_DASHBOARD_TOKEN=
# Private channel key: exactly 32 hexadecimal characters (16 bytes).
# MESHCORE_CHANNEL_IDEENWERFT=
# Optional overrides for config.toml:
# MESHCORE_AI_BASE_URL=https://openrouter.ai/api/v1
# MESHCORE_AI_MODEL=google/gemini-2.5-flash
