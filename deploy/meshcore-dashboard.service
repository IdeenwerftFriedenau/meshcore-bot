[Unit]
Description=MeshCore Pi Configuration Dashboard
After=network.target

[Service]
Type=simple
User=meshcore-ai
Group=meshcore-ai
WorkingDirectory=/var/lib/meshcore-ai-bot
Environment=MESHCORE_AI_DB_PATH=/var/lib/meshcore-ai-bot/bot.sqlite3
Environment=MESHCORE_AI_ASA_INBOX=/var/lib/meshcore-ai-bot/asa
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/meshcore-ai-bot/current/.venv/bin/meshcore-ai dashboard --config /etc/meshcore-ai-bot/config.toml
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
PrivateTmp=true
ReadWritePaths=/etc/meshcore-ai-bot
ReadOnlyPaths=/var/lib/meshcore-ai-bot

[Install]
WantedBy=multi-user.target
