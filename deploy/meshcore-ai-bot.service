[Unit]
Description=MeshCore AI Bot
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=meshcore-ai
Group=meshcore-ai
SupplementaryGroups=dialout
WorkingDirectory=/var/lib/meshcore-ai-bot
Environment=MESHCORE_AI_DB_PATH=/var/lib/meshcore-ai-bot/bot.sqlite3
Environment=PYTHONUNBUFFERED=1
Environment=MESHCORE_AI_ASA_INBOX=/var/lib/meshcore-ai-bot/asa
ExecStart=/opt/meshcore-ai-bot/current/.venv/bin/meshcore-ai run --config /etc/meshcore-ai-bot/config.toml --live
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/meshcore-ai-bot
PrivateTmp=true

[Install]
WantedBy=multi-user.target
