[Unit]
Description=Berlin news from rbb 88.8 DAB+ to MeshCore #news
After=ideenwerft-dab-monitor.service meshcore-gateway.service

[Service]
Type=oneshot
User=marc
Group=marc
ExecStart=/opt/meshcore-ai-bot/current/.venv/bin/python /opt/meshcore-ai-bot/source/deploy/dab/rbb_news.py
TimeoutStartSec=540
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/meshcore-ai-bot /var/lib/meshcore-gateway
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=700M
CPUQuota=200%
UMask=0077
